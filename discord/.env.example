# ─── Discord ───────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Application ID from https://discord.com/developers/applications → General Information
DISCORD_CLIENT_ID=

# Your server (guild) ID — right-click server icon → Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=

# ─── TechPlay Backend ──────────────────────────────────────────────────────────
# Must match DISCORD_BOT_SECRET in backend .env
DISCORD_BOT_SECRET=

# Backend API base URL (no trailing slash)
API_URL=https://techplay.gg/api/v1

# ─── Optional ──────────────────────────────────────────────────────────────────
# Channel ID for weekly Sunday recap (if empty, bot searches for #announcements / #general / #news)
RECAP_CHANNEL_ID=

# Channel ID for news/articles posting — right-click channel → Copy Channel ID
# Recommended: set this to avoid permission issues with name-based lookup
LATEST_NEWS_CHANNEL_ID=

# How often to poll for new content in seconds (default: 600 = 10 minutes)
CHECK_INTERVAL_SECONDS=600

