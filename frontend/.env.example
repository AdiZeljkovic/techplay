NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NEXT_PUBLIC_TURNSTILE_ENABLED=true

# --- On-Demand Revalidation ---
# Shared secret for backend to trigger cache revalidation
# MUST match REVALIDATION_SECRET in backend .env
REVALIDATION_SECRET=your-secret-token-here-change-in-production

# --- Reverb WebSocket ---
NEXT_PUBLIC_REVERB_APP_KEY=techplay-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
