NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NEXT_PUBLIC_TURNSTILE_ENABLED=true

# --- On-Demand Revalidation ---
# Shared secret for backend to trigger cache revalidation
# MUST match REVALIDATE_SECRET_TOKEN in backend .env
REVALIDATE_SECRET_TOKEN=your-secret-token-here-change-in-production

# --- Cloudflare Cache Purge (optional but recommended) ---
# Needed so article edits immediately clear CDN cache
# Get token from: Cloudflare Dashboard → My Profile → API Tokens
# Zone ID from: Cloudflare Dashboard → your domain → Overview (right sidebar)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
NEXT_PUBLIC_APP_URL=https://techplay.gg

# --- Reverb WebSocket ---
#
# Local development, as written below: Reverb on its own port, no TLS.
#
# In production the scheme is https and the port MUST be 443 — nginx carries
# /app and /apps through to Reverb, and Cloudflare serves 8080 as plaintext
# HTTP only, so wss:// on 8080 fails every time. Production values:
#
#   NEXT_PUBLIC_REVERB_HOST=api-beta.techplay.gg
#   NEXT_PUBLIC_REVERB_PORT=443
#   NEXT_PUBLIC_REVERB_SCHEME=https
NEXT_PUBLIC_REVERB_APP_KEY=techplay-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Server-side calls carry this so SSR is exempt from the per-IP rate limit.
# Must match INTERNAL_API_TOKEN in the backend .env. Server-only — never
# prefix it with NEXT_PUBLIC_.
INTERNAL_API_TOKEN=

# Read by ConsentAwareAnalytics; without it the site simply ships no analytics.
NEXT_PUBLIC_GA_ID=

# Read by the shop's PayPal button; without it the button renders and cannot pay.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
