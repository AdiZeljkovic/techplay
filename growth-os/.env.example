# Growth OS — every variable is optional for local use.
# Copy to .env.local (never commit it).

# Access guard. When set, every request needs HTTP Basic auth with these.
# In production mode (next start) the app refuses to serve until they are set.
GROWTH_OS_USER=
GROWTH_OS_PASSWORD=

# Where working state is stored (file store). Default: ./data/state/state.json
GROWTH_OS_STATE_FILE=

# Where the strategy docs live. Default: ../docs/techplay-growth
GROWTH_DOCS_DIR=

# Future integrations (not implemented yet; presence only flips the status to "configured").
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GSC_SITE_URL=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
YOUTUBE_API_KEY=
TIKTOK_ADS_ACCESS_TOKEN=
NEWSLETTER_API_URL=
NEWSLETTER_API_TOKEN=
ANTHROPIC_API_KEY=
