{
  "expo": {
    "name": "TechPlay",
    "slug": "techplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "techplay",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "gg.techplay.app",
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "associatedDomains": [
        "applinks:techplay.gg",
        "applinks:help.techplay.gg"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "gg.techplay.app",
      "userInterfaceStyle": "dark",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "techplay.gg",
              "pathPrefix": "/news"
            },
            {
              "scheme": "https",
              "host": "techplay.gg",
              "pathPrefix": "/games"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#05070A"
          }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#05070A",
    "primaryColor": "#DC143C"
  }
}